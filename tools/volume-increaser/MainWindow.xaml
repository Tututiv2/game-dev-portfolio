<Window x:Class="VolumeIncreaser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Increaser"
        Height="560"
        Width="640"
        MinWidth="520"
        MinHeight="400"
        Background="#FF1A1A1A">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE8E8E8" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#FFE0E0E0" />
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>
      <TextBlock FontSize="22"
                 FontWeight="SemiBold"
                 Text="Volume Increaser"
                 Foreground="White" />
      <TextBlock Margin="0,6,0,0"
                 TextWrapping="Wrap"
                 Foreground="#FFB0B0B0"
                 FontSize="12"
                 Text="Windows does not let the normal master fader go past 100%. This app (1) cranks the normal slider and per-app faders, and (2) can apply extra digital gain when you use a free virtual audio cable in the right order so sound does not double-play or feed back." />
      <Border Margin="0,16,0,0" Padding="12" CornerRadius="4" Background="#2D1F00" BorderBrush="#5C3D00" BorderThickness="1">
        <TextBlock TextWrapping="Wrap" Foreground="#FFEECC88" FontSize="12"
                   Text="Loudness above 100% can clip and distort, and is harder on your ears. Start low, then turn up. If a random booster makes your PC hot or busy, it is not doing real audio work — this one is all local, open, and you can read every line." />
      </Border>

      <GroupBox Margin="0,18,0,0" Header="Primary output" Foreground="White" BorderBrush="#444">
        <StackPanel Margin="0,4,0,0">
          <TextBlock TextWrapping="Wrap" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,8"
                     Text="This is the device Windows shows as the default speaker or headphones. Use the slider the same way as the one in the system tray, but in one place." />
          <ComboBox x:Name="RenderDeviceCombo" MinHeight="28" SelectionChanged="RenderDeviceCombo_OnSelectionChanged" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
            <TextBlock Text="Level (0–100%): " VerticalAlignment="Center" />
            <TextBlock x:Name="MasterPercentLabel" Text="0%" MinWidth="36" VerticalAlignment="Center" />
          </StackPanel>
          <Slider x:Name="MasterSlider" Minimum="0" Maximum="100" TickFrequency="1"
                  IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="MasterSlider_OnValueChanged" />
          <Button x:Name="MaxMasterButton" Content="Set master to 100%" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0" Click="MaxMasterButton_OnClick" />
        </StackPanel>
      </GroupBox>

      <GroupBox Margin="0,12,0,0" Header="Per-app faders" Foreground="White" BorderBrush="#444">
        <StackPanel Margin="0,4,0,0">
          <TextBlock TextWrapping="Wrap" Foreground="#FFAAAAAA" FontSize="12"
                     Text="Sets each active mixer's session to 100% (best effort; some system sessions are fixed)." />
          <Button Content="Set all app volumes on this device to 100%" Width="360" HorizontalAlignment="Left" Margin="0,8,0,0" Click="MaxAllSessionsButton_OnClick" />
        </StackPanel>
      </GroupBox>

      <GroupBox Margin="0,12,0,0" Header="Overdrive (virtual cable) — this is the real 'above 100%'" Foreground="White" BorderBrush="#444">
        <StackPanel Margin="0,4,0,0">
          <TextBlock TextWrapping="Wrap" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,8"
                     Text="1) Install VB-Audio Virtual Cable (donateware from vb-audio.com; not bundled here). 2) In Windows, set the default *playback* device to the cable input (name usually contains 'CABLE' and 'Input'). 3) Pick the cable *recording* output below (often 'CABLE Output'). 4) Choose your real speakers/headphones as 'Play to'. 5) Press Start. Your apps send audio into the cable; this app re-plays that signal to your real device with added gain. Stop when you are done." />
          <TextBlock x:Name="VbcLink" Foreground="#FF6BB3FF" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="VbcLink_OnClick"
                     Text="Open VB-Audio Virtual Cable download page" Margin="0,0,0,8" />

          <Label Content="From (cable / capture)" />
          <ComboBox x:Name="CaptureDeviceCombo" MinHeight="28" />
          <Label Content="Play to (speakers or headphones)" Margin="0,8,0,0" />
          <ComboBox x:Name="OverdriveOutCombo" MinHeight="28" />

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
            <TextBlock Text="Extra gain: " VerticalAlignment="Center" />
            <TextBlock x:Name="GainPercentLabel" Text="100%" MinWidth="48" VerticalAlignment="Center" />
            <TextBlock Margin="8,0,0,0" Foreground="#FF888888" FontSize="11" Text="(100% = unity; 200% = double amplitude)" />
          </StackPanel>
          <Slider x:Name="GainSlider" Minimum="100" Maximum="300" Value="150" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="GainSlider_OnValueChanged" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="StartBoostButton" Content="Start" Width="90" Click="StartBoostButton_OnClick" />
            <Button x:Name="StopBoostButton" Content="Stop" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="StopBoostButton_OnClick" />
            <TextBlock x:Name="EngineStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FFAAAAAA" Text="Idle" />
          </StackPanel>
        </StackPanel>
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</Window>
