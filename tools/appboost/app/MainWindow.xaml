<Window x:Class="AppBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppBoost" Height="560" Width="600"
        Background="#16161a" Foreground="#e8e8ea"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e8e8ea"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="AppBoost" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="The green bar is live sound. Tick an app that is moving, then drag its dial."
                       Foreground="#8b8b93" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Refresh list" Click="Refresh_Click" Padding="14,6"
                    Background="#2a2a31" Foreground="#e8e8ea" BorderThickness="0"/>
            <TextBlock x:Name="Hint" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="#8b8b93" TextWrapping="Wrap"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1e1e24" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                          Margin="0,0,10,0" IsChecked="{Binding Enabled}"/>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#8b8b93" Margin="10,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PercentText}"
                                           FontSize="15" FontWeight="SemiBold" MinWidth="52"
                                           TextAlignment="Right"/>

                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                             Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                             Value="{Binding Level, Mode=OneWay}"
                                             Background="#2a2a31" Foreground="#4ade80"
                                             BorderThickness="0"/>

                                <Slider Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                        Margin="0,6,0,0" Minimum="0" Maximum="400"
                                        SmallChange="5" LargeChange="25" TickFrequency="100"
                                        TickPlacement="BottomRight"
                                        IsEnabled="{Binding Enabled}"
                                        Value="{Binding Percent, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding Error}" Foreground="#ff7a7a"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
