<Window x:Class="AudioCapture.TakeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take saved" SizeToContent="Height" Width="470"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="Headline" Text="Saved" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock x:Name="Details" Grid.Row="1" Style="{StaticResource Hint}" Margin="18,0,0,14"/>

        <TextBlock Grid.Row="2" Text="NAME THIS TAKE" Style="{StaticResource Label}"/>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Grid.Column="0" MinHeight="32" FontSize="14"/>
            <Button x:Name="PlayBtn" Grid.Column="1" Content="&#9654;&#160; Play" Style="{StaticResource Ghost}"
                    Height="32" Margin="8,0,0,0" Click="Play_Click"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Discard" Style="{StaticResource Ghost}" Height="34"
                    Foreground="{StaticResource Rec}" Click="Discard_Click"/>

            <CheckBox x:Name="AskAgain" Grid.Column="1" Content="Ask after every take" IsChecked="True"
                      VerticalAlignment="Center" Margin="14,0,0,0"/>

            <Button x:Name="KeepBtn" Grid.Column="2" Content="Keep" Style="{StaticResource Big}" Height="34"
                    MinWidth="130" Background="{StaticResource Accent}" Click="Keep_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
