      "com.secondwatch.client.SecondWatchClient"
    ],
    "voicechat": [
      "com.secondwatch.game.VoiceBridge"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  }
}
